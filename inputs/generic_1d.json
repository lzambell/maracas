{
    "simulation":
    {
	"dt":2, //time of one increment
    	"conv_poisson":150, //convergence criteria for solving poisson equation
	"conv_simu":1e-6, ////convergence criteria of the whole simulation
        "timesteps":800000, //max nb of iteration
        "static":false, //i.e. transports ions at each step
    },

    "physics":{	    		
	"T":89, //LAr temperature in K	
	"mu":1.6e-7, //ion mobility in m^2/V/s
	"S":2e-10, //charge input rate in C/m^3/s	
	"D":0, //Diffusion coefficient (otherwise set to mu*kB*T/q)
    },
        
    "lar_flow":{
	"constant":[0.000,0,0], //in m/s
	//to implement: other generic options, input file
    },
    
    "geometry":{
	"dimension":1,
	"direction":"horizontal", //not relevant in 1D
	"dx":0.05, //voxel size in m
	"dy":0,
	"dz":0,

	//box definition  3D corner coordinates + 3D lengthes
	//(X, Y, Z, DX, DY, DZ)
	//-> set irrelevant coordinates to null

	"volume":{
	    "box":[0, null, null, 3.6, null, null],
	},

	"field_cage":{
	    "box":[0, null, null, 3.6, null, null],
	    "gradient":[0,-180000], //in V 
	},

	//plane definition as for the box: 3D corner coordinates + 3D lengthes
	//(x0, y0, z0, dx, dy, dz)
	//--> missing coordinate are null

	"anode_plane":{
	    "plane":[[0, null, null, 0, null, null]],
	    "potential":[0], //in V
	    
	},
	
	"cathode_plane":{
	    "plane":[[3.6, null, null, 0, null, null]],
	    "potential":[-180000],
	},
    },
    "distortions":{
        //all units in m
        "ds":0.001, //step size for electron path
        "dx":0.05,  //distortion maps binning in m
        "dy":0.0,  //distortion maps binning in m
        "dz":0.0,  //distortion maps binning in m
        "max_iter":30, //max nb of iteration for backward map
        "norm_tol":0.0001, //stopping norm criteria for backward map
        //collection area box as (x0, y0, z0, Dx, Dy, Dz)
        //not used in the distortion computation (but stored in the output file if one uses it in analysis afterwards)
        "collection_area":[0, null, null, 3.6, null, null],
    },		
    
}
    

